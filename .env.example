# AssetVault environment template
# Copy to `.env` (repo root, for Docker Compose) and/or `backend/.env` (native runs).
# Never commit real secrets.

# ── Required (production / docker-compose.prod.yml) ──────────────────────────
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-use-openssl-rand-hex-32
# Must be >= 32 bytes and must NOT be one of:
#   assetvault-production-secret-key-2024
#   assetvault-production-secret-key-2024-change-me
#   assetvault-secret-key-change-in-production
REDIS_PASSWORD=change-me-strong-redis-password
GROQ_API_KEY=

# Required when running seed.py (prod has no default; compose.dev defaults for local only)
SEED_PASSWORD=change-me-strong-seed-password

# ── Optional overrides ───────────────────────────────────────────────────────
# ENVIRONMENT=development   # set to "production" to disable /docs,/redoc,/openapi.json
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=llama-3.3-70b-versatile

# Trial length in days (no permanent free tier; enforcement is a later phase)
# TRIAL_LENGTH_DAYS=14

# Production domain (docker-compose.prod.yml). CORS origins and nginx server_name
# are derived from these — change BASE_DOMAIN at cutover instead of hunting hardcodes.
# BASE_DOMAIN=assetvault.uz
# LEGACY_BASE_DOMAIN=datamou.uz
# APP_SUBDOMAIN=app
# PLATFORM_SUBDOMAIN=admin
# Wildcard TLS (*.assetvault.uz) requires a DNS-01 Let's Encrypt cert; HTTP-01
# cannot issue wildcards. Named hosts still work on the existing certificate.
# TLS_CERT_NAME=assetvault.uz
# NGINX_SERVER_NAMES=app.assetvault.uz assetvault.uz demo.assetvault.uz *.assetvault.uz
# Platform console hosts (served from dist-admin/, must not overlap the list above):
# NGINX_PLATFORM_SERVER_NAMES=admin.assetvault.uz
# Legacy VC host — 301 to the canonical app (not served as SPA):
# NGINX_LEGACY_REDIRECT_NAMES=asset.datamou.uz
# NGINX_CANONICAL_APP_ORIGIN=https://app.assetvault.uz
# Frontend bake-time hostname (optional for native Vite builds):
# VITE_BASE_DOMAIN=assetvault.uz
# VITE_APP_SUBDOMAIN=app

# Platform operator bootstrap (optional; both required when either is set)
# PLATFORM_ADMIN_EMAIL=ops@assetvault.uz
# PLATFORM_ADMIN_PASSWORD=change-me-strong-platform-password
# PLATFORM_ADMIN_FULL_NAME=Platform Operator

# JWT audiences (defaults are fine for most deployments)
# JWT_AUDIENCE=assetvault-api
# JWT_PLATFORM_AUDIENCE=assetvault-platform

# Native backend/.env also needs:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/assetvault
# SYNC_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/assetvault
# REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0
# CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
