# ---- build stage ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Bake the public hostname into the SPA (landing/login QR + labels)
ARG VITE_BASE_DOMAIN=assetvault.uz
ARG VITE_APP_SUBDOMAIN=app
ENV VITE_BASE_DOMAIN=$VITE_BASE_DOMAIN
ENV VITE_APP_SUBDOMAIN=$VITE_APP_SUBDOMAIN
# Tenant SPA (index.html -> dist/) and platform console (admin.html -> dist-admin/)
# are separate rollup graphs, mirroring the two dev servers on :5173 and :5174.
RUN npm run build && npm run build:admin

# ---- serve stage (unprivileged nginx; listens 8080/8443) ----
FROM nginxinc/nginx-unprivileged:alpine
# Template is rendered by /docker-entrypoint.d/20-envsubst-on-templates.sh into
# /etc/nginx/conf.d/default.conf. Do NOT mount a finished conf over conf.d — that
# blocks envsubst. Restrict substitution via NGINX_ENVSUBST_FILTER so $host/$uri/…
# nginx runtime variables are not blanked out.
USER root
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/dist-admin /usr/share/nginx/html-admin
# Ensure static files are readable by the nginx user (uid 101)
RUN chown -R nginx:nginx /usr/share/nginx/html /usr/share/nginx/html-admin
USER nginx
EXPOSE 8080 8443
CMD ["nginx", "-g", "daemon off;"]
